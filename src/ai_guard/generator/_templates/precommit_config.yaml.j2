# AI Guard managed pre-commit configuration
# Do not edit manually - run 'ai-guard install' to regenerate
# Generated by ai-guard version {{ version }}

repos:
  - repo: local
    hooks:
{% if code.commit_format %}
{% for lang, tools in languages.items() %}
      - id: format-{{ lang }}
        name: Format ({{ lang }})
        entry: {{ tools.format }}
        language: system
        types: [{{ lang_types.get(lang, lang) }}]
        pass_filenames: true
{% endfor %}
{% endif %}
{% if code.push_lint %}
{% for lang, tools in languages.items() %}
      - id: lint-{{ lang }}
        name: Lint ({{ lang }})
        entry: {{ tools.lint }}
        language: system
        types: [{{ lang_types.get(lang, lang) }}]
        pass_filenames: true
{% endfor %}
{% endif %}
{% for name, check in checks.items() %}
      - id: custom-{{ name | replace(" ", "-") | lower }}
        name: {{ name }}
        entry: {{ check.command }}
        language: system
{% if check.types %}
        types: [{{ check.types | join(", ") }}]
{% endif %}
        pass_filenames: {{ check.pass_filenames }}
{% endfor %}
