"""Claude Code PreToolUse Hook for AI Guard.

Generated by `ai-guard install --agent claude-code`.
This file is managed by AI Guard — do not edit manually.

The content within managed block markers is automatically
regenerated on `ai-guard update`. Custom additions outside
the managed block are preserved.
"""

import json
import sys
from pathlib import Path

# Policy cache path (generated by ai-guard install)
POLICY_PATH = Path(".ai-guard/policy.json")


def load_policy() -> dict | None:
    """Load policy from cache file.

    Returns:
        Policy dict if valid, None if no policy installed,
        {"fail_closed": True} if policy is corrupted (fail-closed).
    """
    if not POLICY_PATH.exists():
        # No policy installed - allow all (first-time usage)
        return None
    try:
        return json.loads(POLICY_PATH.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        # Corrupted policy - fail-closed: deny all
        return {"fail_closed": True}


def classify_tool(tool_name: str, tool_input: dict) -> tuple[str, str]:
    """Classify tool call into (operation, target).

    Claude Code uses uppercase tool names in Hook JSON.

    Args:
        tool_name: Tool name from Claude Code (e.g., "Read", "Write", "Bash").
        tool_input: Tool arguments dict.

    Returns:
        (operation, target) where operation is "read", "write", or "execute",
        and target is the file path or command string.
    """
    # Read operations
    if tool_name in ("Read", "read_file", "glob"):
        return ("read", tool_input.get("file_path", tool_input.get("pattern", "")))

    # Write operations
    if tool_name in ("Write", "write_file"):
        return ("write", tool_input.get("file_path", ""))
    if tool_name in ("Edit", "edit_file", "edit"):
        return ("write", tool_input.get("file_path", tool_input.get("path", "")))
    if tool_name in ("NotebookEdit", "notebook_edit"):
        return ("write", tool_input.get("notebook_path", ""))

    # Execute operations
    if tool_name in ("Bash", "bash", "Task", "task"):
        return ("execute", tool_input.get("command", tool_input.get("prompt", "")))

    # MCP/Web operations - classified as execute
    if tool_name.startswith("mcp__") or tool_name in ("WebFetch", "WebSearch"):
        return ("execute", f"{tool_name}:{tool_input}")

    # Unknown operation - allow by default
    return ("unknown", "")


def evaluate_policy(policy: dict | None, operation: str, target: str) -> str:
    """Evaluate policy for the given operation and target.

    Placeholder implementation - WP2 will integrate proper Enforcer.

    Args:
        policy: Loaded policy dict or None.
        operation: Operation type ("read", "write", "execute").
        target: Target resource (file path, command, etc.).

    Returns:
        Decision: "allow", "deny", or "ask".
    """
    if policy is None:
        return "allow"

    if policy.get("fail_closed"):
        return "deny"

    # TODO: WP2 - Call Enforcer for proper pattern matching
    # Placeholder: check simple forbidden patterns from policy
    behavior = policy.get("behavior", {})
    op_rules = behavior.get(operation, {})
    forbidden = op_rules.get("forbidden", [])

    # Simple prefix match placeholder (WP2 will use glob/regex)
    for rule in forbidden:
        pattern = rule.get("pattern", "")
        if target.startswith(pattern.replace("*", "").replace("file:", "")):
            return "deny"

    return "allow"


def main():
    """Main hook entry point."""
    # Read tool call from stdin (Claude Code format)
    input_data = json.load(sys.stdin)
    tool_name = input_data.get("tool_name", "")
    tool_input = input_data.get("tool_input", {})

    # Load policy
    policy = load_policy()

    # Classify and evaluate
    operation, target = classify_tool(tool_name, tool_input)
    decision = evaluate_policy(policy, operation, target)

    # Output Claude Code expected format
    # permissionDecision: "allow" | "deny" | "ask"
    output = {
        "hookSpecificOutput": {
            "permissionDecision": decision,
        }
    }

    json.dump(output, sys.stdout)
    print()  # Ensure newline for Claude Code to read properly


if __name__ == "__main__":
    main()
