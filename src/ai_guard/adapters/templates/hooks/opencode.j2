/**
 * Classify tool call into operation type.
 */
function classifyTool(call: ToolCall): { operation: string; target: string } {
  const toolName = call.tool;
  const args = call.args || {};

  // Read operations
  if (["read", "read_file", "glob"].includes(toolName)) {
    return { operation: "read", target: args.file_path || args.pattern || "" };
  }

  // Write operations
  if (["write", "write_file", "edit", "edit_file"].includes(toolName)) {
    return { operation: "write", target: args.file_path || args.path || "" };
  }

  // Execute operations
  if (["bash", "shell", "execute"].includes(toolName)) {
    return { operation: "execute", target: args.command || "" };
  }

  return { operation: "unknown", target: "" };
}

/**
 * Evaluate policy for the given operation.
 * Placeholder for WP2.
 */
function evaluatePolicy(
  policy: Record<string, unknown> | null,
  operation: string,
  target: string
): "allow" | "deny" | "ask" {
  if (!policy) {
    return "allow";
  }

  // TODO: WP2 - Call Enforcer for proper pattern matching
  return "allow";
}

/**
 * OpenCode plugin intercept handler.
 * Called before each tool execution.
 */
export function intercept(call: ToolCall): void {
  const policy = loadPolicy();
  const { operation, target } = classifyTool(call);
  const decision = evaluatePolicy(policy, operation, target);

  if (decision === "deny") {
    throw new Error(
      `AI Guard: Operation blocked by policy\n` +
        `Tool: ${call.tool}\n` +
        `Operation: ${operation}\n` +
        `Target: ${target}`
    );
  }

  if (decision === "ask") {
    // TODO: WP2 - Implement user confirmation prompt
    // Placeholder: treat as allow
    console.log("AI Guard: Would ask user for confirmation");
  }

  // Allow operation to proceed
}
