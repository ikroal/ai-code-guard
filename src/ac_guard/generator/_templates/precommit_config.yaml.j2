# Generated by ac-guard install from guard.yaml.
# DO NOT EDIT — this file is overwritten on every `ac-guard install`.
# Edit guard.yaml (code.<stage>.*) instead.
# ac-guard version: {{ version }}
{% if meta.minimum_version %}
minimum_pre_commit_version: "{{ meta.minimum_version }}"
{% endif %}
{% if meta.default_install_hook_types %}
default_install_hook_types: {{ meta.default_install_hook_types | tojson }}
{% endif %}
{% if meta.default_language_version %}
default_language_version:
{% for lang, ver in meta.default_language_version.items() %}
  {{ lang }}: {{ ver }}
{% endfor %}
{% endif %}

repos:
{% for stage in rendered_stages %}
  # ---- {{ stage.stage }} stage ----
{% if stage.local_hooks %}
  - repo: local
    hooks:
{% for h in stage.local_hooks %}
      - id: {{ h.id }}
{% for k, v in h.items() %}
{% if k != "id" %}
        {{ k }}: {{ v | tojson }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% for r in stage.external_repos %}
  - repo: {{ r.repo }}
{% if r.rev is defined and r.rev is not none %}
    rev: {{ r.rev }}
{% endif %}
    hooks:
{% for h in r.hooks %}
      - id: {{ h.id }}
{% for k, v in h.items() %}
{% if k != "id" %}
        {{ k }}: {{ v | tojson }}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
{% endfor %}
{% if extra_repos %}
  # ---- _extra (non-gating stages: post-* / manual / prepare-commit-msg) ----
{% for r in extra_repos %}
  - repo: {{ r.repo }}
{% if r.rev is defined and r.rev is not none %}
    rev: {{ r.rev }}
{% endif %}
    hooks:
{% for h in r.hooks %}
      - id: {{ h.id }}
{% for k, v in h.items() %}
{% if k != "id" %}
        {{ k }}: {{ v | tojson }}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
{% endif %}
