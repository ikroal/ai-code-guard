"""GitHub Copilot PreToolUse Hook for AI Code Guard.

Generated by `ac-guard install --agent copilot`.
This file is managed by AI Code Guard — do not edit manually.

The content within managed block markers is automatically
regenerated on `ac-guard update`. Custom additions outside
the managed block are preserved.
"""

import json
import os
import sys
from pathlib import Path

# --- PATH-resilient re-exec shim ---
# Copilot runs this hook via the `python3` on $PATH of the shell that
# launched the agent. When that shell did not activate the project's venv,
# `python3` resolves to a system interpreter that cannot import ac_guard.
# To stay correct under any launch path, we bake the absolute path of the
# Python that ran `ac-guard install` and re-exec into it when they differ.
_INSTALL_PY = {{ python_executable | tojson }}
if sys.executable != _INSTALL_PY and os.path.exists(_INSTALL_PY):
    os.execv(_INSTALL_PY, [_INSTALL_PY, __file__, *sys.argv[1:]])

# --- Safe-deny on import failure ---
# If ac_guard is still not importable after the shim, never let the tool
# call silently pass — emit a deny decision so the user sees the problem.
try:
    from ac_guard.action_guard.core import evaluate
except ImportError as _exc:
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "onPreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": (
                    f"ac-guard hook could not import ac_guard ({_exc}); "
                    "reinstall ac-guard or re-run `ac-guard install`"
                ),
            }
        },
        sys.stdout,
    )
    print()
    sys.exit(2)


def main():
    """Main hook entry point."""
    # Read tool call from stdin (Copilot format)
    input_data = json.load(sys.stdin)
    tool_name = input_data.get("tool_name", "")
    tool_input = input_data.get("tool_input", {})

    # Evaluate policy via Action guard
    result = evaluate(tool_name, tool_input, Path("."), agent="copilot")

    # Build reason string for deny/ask decisions
    reason = ""
    if result.matched_rule:
        reason = result.matched_rule.reason or result.matched_rule.message or ""

    # Output Copilot expected format
    output = {
        "hookSpecificOutput": {
            "hookEventName": "onPreToolUse",
            "permissionDecision": result.decision.value,
        }
    }

    # Add reason for deny/ask
    if reason and result.decision.value != "allow":
        output["hookSpecificOutput"]["permissionDecisionReason"] = reason

    json.dump(output, sys.stdout)
    print()  # Ensure newline for Copilot to read properly

    # Exit code 2 = blocking error for Copilot
    if result.decision.value == "deny":
        sys.exit(2)


if __name__ == "__main__":
    main()
