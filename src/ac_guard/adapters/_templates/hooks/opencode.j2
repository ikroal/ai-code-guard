{#
OpenCode Plugin template (TypeScript).

Generates a TypeScript plugin that:
1. Intercepts tool calls via OpenCode plugin API
2. Calls Action guard via python3 -m ac_guard.action_guard subprocess
3. Throws error to block forbidden operations

This template is rendered by adapters/_render.render_hook("opencode", behavior).
#}
/**
 * OpenCode Plugin for AI Code Guard
 *
 * Generated by `ac-guard install --agent opencode`.
 * This file is managed by AI Code Guard — do not edit manually.
 *
 * OpenCode plugin API:
 * - Intercept tool calls before execution
 * - Throw error to block operation
 * - Return/continue to allow operation
 */

import type { Tool, ToolCall } from "opencode";
import { execSync } from "child_process";

// Policy evaluation via Python Action guard subprocess
function evaluatePolicy(call: ToolCall): {
  decision: string;
  reason?: string;
} {
  const input = JSON.stringify({
    tool_name: call.tool,
    tool_input: call.args || {},
    agent: "opencode",
  });

  try {
    const output = execSync(`echo '${input.replace(/'/g, "\\'")}' | python3 -m ac_guard.action_guard`, {
      encoding: "utf-8",
      timeout: 5000,
      stdio: ["pipe", "pipe", "pipe"],
    }).trim();
    return JSON.parse(output);
  } catch {
    // Fail-closed: subprocess error → deny
    return { decision: "deny", reason: "Action guard subprocess error" };
  }
}

/**
 * OpenCode plugin intercept handler.
 * Called before each tool execution.
 */
export function intercept(call: ToolCall): void {
  const result = evaluatePolicy(call);

  if (result.decision === "deny") {
    throw new Error(
      `AI Code Guard: Operation blocked by policy\n` +
        `Tool: ${call.tool}\n` +
        (result.reason ? `Reason: ${result.reason}\n` : "")
    );
  }

  if (result.decision === "ask") {
    // OpenCode supports ask via plugin API
    console.warn(
      `AI Code Guard: Operation requires approval — ${result.reason || "policy rule"}`
    );
  }

  // Allow operation to proceed
}
