{#
GitHub Copilot rule document template.

Copilot supports Hook capability via onPreToolUse events:
- PreToolUse Hook for runtime interception (can_block=True)
- Permission decision for user confirmation (can_ask=True)

This template extends the base template with Copilot-specific formatting.
#}

{% extends "rule_docs/base.md.j2" %}

{# Copilot uses base template without modifications #}

{% for op_name, op_rules in operations %}
### {{ op_name }} Operations

{% if op_rules.forbidden %}
**Forbidden** (recommended deny):
{% for rule in op_rules.forbidden %}
- `{{ rule.pattern }}`{% if rule.reason %} — {{ rule.reason }}{% endif %}
{% endfor %}

{% endif %}

{% if op_rules.require_approval %}
**Require Approval** (recommended deny - no ask capability):
{% for rule in op_rules.require_approval %}
- `{{ rule.pattern }}`{% if rule.message %} — {{ rule.message }}{% endif %}
{% endfor %}

{% endif %}

{% if op_rules.allow %}
**Allowed** (permitted):
{% for rule in op_rules.allow %}
- `{{ rule.pattern }}`
{% endfor %}

{% endif %}
{% endfor %}
