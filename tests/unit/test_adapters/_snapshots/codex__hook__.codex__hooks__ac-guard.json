{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/ac-guard.py",
            "timeout": 30,
            "statusMessage": "AI Code Guard: checking policy"
          }
        ]
      }
    ]
  }
}
